# Server
PORT=5000
NODE_ENV=development          # set to "production" when deploying

# MongoDB
# Get this from MongoDB Atlas → Connect → Drivers, or use a local URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
# Any long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Email (Nodemailer)
# For Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Cloudinary
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Arcjet (rate limiting + bot protection)
# https://app.arcjet.com → create a site → copy the key
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development        # set to "production" when deploying

# Frontend URL (used for CORS on the socket server)
CLIENT_URL=http://localhost:5173
